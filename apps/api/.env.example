DATABASE_URL=postgresql://member:member@localhost:5432/member?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
# R2 비공개 버킷. 값이 비어 있으면 업로드·다운로드는 503이다. 비밀 값은 커밋하지 말 것.
# R2_* 가 있으면 STORAGE_* 보다 우선한다. dev 와 prod 는 R2_PREFIX_ENV 또는 버킷으로 나눈다.
# R2_BUCKET=jci-korea-media
# R2_PREFIX_ENV=dev
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
NODE_ENV=development
PORT=3001

# 모임관리 모듈은 위의 JWT 시크릿과 같은 값을 audience=gathering 으로 구분한다.
# 아래 값은 예시이거나 비어 있다. 운영 비밀을 이 파일에 넣지 말 것.
# GATHERING_JOB_SECRET=  16자 이상. 비우면 리마인드와 이용권 안내 작업 경로는 응답하지 않는다.
# GATHERING_OPERATOR_SECRET=  16자 이상. 비우면 이용권 수동 부여 경로는 응답하지 않는다. 앱 안에 두지 말 것.
# GATHERING_DEV_STORAGE=1  운영에서는 무시된다. 로컬 통합 테스트가 R2 대신 임시 파일로 서명 URL을 주고받는다.
# EXPO_ACCESS_TOKEN=  Expo 푸시 강화 인증. 없어도 발송 코드는 동작할 수 있다.
# 새 Railway PostgreSQL과 R2는 문서를 보고 사람이 만든다. 이 예시 URL은 로컬 전용이다.
