DATABASE_URL=postgresql://member:member@localhost:5432/member?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
NODE_ENV=development
PORT=3001

# 모임관리 모듈은 위의 JWT 시크릿과 같은 값을 audience=gathering 으로 구분한다.
# 아래 값은 예시이거나 비어 있다. 운영 비밀을 이 파일에 넣지 말 것.
# GATHERING_JOB_SECRET=  16자 이상. 비우면 리마인드 작업 경로는 응답하지 않는다.
# EXPO_ACCESS_TOKEN=  Expo 푸시 강화 인증. 없어도 발송 코드는 동작할 수 있다.
# 새 Railway PostgreSQL과 R2는 문서를 보고 사람이 만든다. 이 예시 URL은 로컬 전용이다.
