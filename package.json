{
  "name": "member",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint -w @member/api && npm run lint -w @member/mobile && npm run lint -w @member/gathering-mobile",
    "typecheck": "npm run typecheck -w @member/shared && npm run typecheck -w @member/contracts && npm run typecheck -w @member/gathering-domain && npm run typecheck -w @member/api && npm run typecheck -w @member/mobile && npm run typecheck -w @member/gathering-mobile",
    "test": "npm run test -w @member/gathering-domain && npm run test -w @member/api",
    "build": "npm run build -w @member/shared && npm run build -w @member/contracts && npm run build -w @member/gathering-domain && npm run build -w @member/api",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "gathering:e2e": "tsx scripts/gathering-e2e/run.ts",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma --force",
    "api:dev": "npm run dev -w @member/api",
    "mobile:start": "npm run start -w @member/mobile"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "expo": "54.0.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "expo": "54.0.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "expo-constants": "18.0.14",
    "expo-dev-client": "6.0.21",
    "expo-device": "8.0.10",
    "expo-file-system": "19.0.24",
    "expo-image-manipulator": "14.0.8",
    "expo-image-picker": "17.0.11",
    "expo-linking": "8.0.12",
    "expo-notifications": "0.32.17",
    "expo-router": "6.0.24",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "6.0.9",
    "expo-video": "3.0.16"
  }
}
